# Copia esto a `.env` EN EL SERVIDOR (nunca lo subas a git) y rellena los huecos.
# docker compose lee este fichero automáticamente si se llama `.env`.

# ── Dominio ──
# Tiene que apuntar por DNS (registro A) a la IP pública de la máquina ANTES de
# levantar el compose: Caddy valida el dominio contra Let's Encrypt al arrancar.
DOMINIO=api.tudominio.com

# ── Base de datos ──
DB_USERNAME=personaltrainer
# Genera una nueva: openssl rand -base64 24
# NO reutilices la de desarrollo: es 'password' y estuvo en el historial de git.
DB_PASSWORD=CAMBIAME
DB_DATABASE=entrenador_ia_db

# ── Autenticación ──
# openssl rand -base64 48
JWT_SECRET=CAMBIAME
JWT_EXPIRES_IN=30d

# Clave con la que el servicio Python se identifica ante NestJS.
# openssl rand -base64 32
INTERNAL_API_KEY=CAMBIAME

# ── Claves de IA (las mismas que usas en local) ──
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
# Súbelo si pasas del tier gratuito de Groq.
GROQ_TPM_LIMIT=8000
