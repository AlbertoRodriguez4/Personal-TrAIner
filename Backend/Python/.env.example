GEMINI_API_KEY=

# Grounding con Google Search en el chat (opcional, apagado por defecto).
# Ponlo a 1 solo si la cuenta de Gemini tiene búsqueda habilitada: es una
# función facturable con cuota propia, y sin ella la API responde 429 a
# cualquier petición que incluya la herramienta de búsqueda.
GEMINI_ENABLE_SEARCH_GROUNDING=

# Modelo de Gemini para el chat (opcional). Por defecto gemini-3.5-flash-lite:
# en el tier gratuito tiene 15 RPM / 500 RPD frente a los 5 RPM / 20 RPD de
# gemini-3.5-flash (verificado en aistudio.google.com/rate-limit), con el
# mismo soporte de imagen (nutricion/analisis_fisico) y de grounding.
GEMINI_MODEL=

# Modelo de respaldo (opcional, vacío = sin cambio de comportamiento). Si
# GEMINI_MODEL agota los reintentos por 429/RESOURCE_EXHAUSTED, se hace un
# único intento más contra este modelo antes de rendirse (503 al usuario) — ya
# no hay fallback a Groq desde acá: nutricion/analisis_fisico son Gemini-only
# por diseño (enrutamiento estricto por modo, no un fallback reactivo).
# gemini-3.5-flash como respaldo de flash-lite: cupo propio y separado
# (los límites de Gemini son por modelo dentro del proyecto, no un pozo
# compartido), así que aunque tenga menos RPD sigue siendo una segunda
# oportunidad real cuando se agota flash-lite.
GEMINI_MODEL_FALLBACK=gemini-3.5-flash

# Groq — proveedor ÚNICO de los modos de texto puro (creador_rutina,
# revisor_rutina, sueno_recuperacion, entrenamiento). Enrutamiento estricto
# por modo, no un fallback: estos modos nunca llaman a Gemini. nutricion y
# analisis_fisico requieren imagen, que Groq no procesa, y se quedan
# exclusivamente en Gemini.
GROQ_API_KEY=
# NUNCA llama-3.3-70b-versatile ni qwen/qwen3-32b (deprecados por Groq).
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# APIs externas — catálogos/bases de datos públicas para enriquecer las
# respuestas de creador_rutina/revisor_rutina/nutricion/sueno_recuperacion.
# Ver backend_python_ai/SKILL.md para el patrón de integración y límites.
# ============================================================

# wger (catálogo de ejercicios, creador_rutina/revisor_rutina): sin API key,
# lectura pública sin límite en https://wger.de/api/v2/ — no hace falta nada
# acá, es solo para que quede documentado por qué no hay WGER_API_KEY.

# Open Food Facts (nutricion): sin API key. Solo pide un User-Agent
# descriptivo con un contacto — poné el tuyo, no lo dejes vacío.
OPENFOODFACTS_USER_AGENT=PersonalTrAIner/1.0 (tu-email-de-contacto)

# USDA FoodData Central (nutricion, ingredientes crudos). Key gratis e
# instantánea en https://fdc.nal.usda.gov/api-key-signup/ — 1000 req/hora.
USDA_FDC_API_KEY=

# Edamam Nutrition Analysis, vía RapidAPI (nutricion, platos con varios
# ingredientes en texto libre). Suscribite a la API en rapidapi.com/edamam —
# 1000 req/día gratis, uso personal/no comercial. La misma key sirve para
# cualquier otra API del marketplace de RapidAPI que se sume más adelante
# (p. ej. ExerciseDB) — no es "múltiples keys por servicio", es una key de
# cuenta válida para todo RapidAPI.
RAPIDAPI_KEY=

# OpenFDA (sueno_recuperacion, info de medicamentos/suplementos que mencione
# el usuario). Funciona sin key (1000 req/día) pero con key gratis en
# https://open.fda.gov/apis/authentication/ el límite sube a 120000 req/día.
OPENFDA_API_KEY=
