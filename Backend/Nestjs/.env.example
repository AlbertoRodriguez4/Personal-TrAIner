DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=entrenador_ia_db
# Normalmente NO hace falta tocarla: el TLS se decide por DB_HOST (localhost,
# 127.0.0.1 y el `db` de docker-compose van sin TLS; cualquier otro host, con
# TLS, que es lo que exigen Neon/RDS). Ponla solo para forzar el caso raro:
# true = exigir TLS siempre, false = no usarlo nunca.
DB_SSL=

AI_PYTHON_URL=http://127.0.0.1:8000
AI_PYTHON_NUTRITION_PATH=/api/ia/analizar-nutricion

# ── Autenticación ──
# Sin esto el servidor NO arranca, y es a propósito: un secreto por defecto en
# el código sería el mismo en todos los despliegues y cualquiera podría firmarse
# un token válido. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Duración de la sesión (opcional, por defecto 30d).
JWT_EXPIRES_IN=30d

# Clave con la que el servicio Python se identifica ante esta API. Tiene que ser
# LA MISMA que la del .env de Python. Genera una con: openssl rand -base64 32
INTERNAL_API_KEY=
